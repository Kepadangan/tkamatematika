            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            font-weight: bold;
            margin: 0 auto 20px;
        }
        .progress-bar {
            height: 8px;
            background: var(--border);
            border-radius: 4px;
            margin-bottom: 20px;
            overflow: hidden;
        }
        .progress-fill {
            height: 100%;
            background: var(--primary);
            width: 0%;
            transition: width 0.3s;
        }
        .review-list {
            text-align: left;
            margin-top: 30px;
            border-top: 1px solid var(--border);
            padding-top: 20px;
        }
        .review-item {
            margin-bottom: 15px;
            padding: 15px;
            border-radius: 8px;
            background: #f9fafb;
        }
        .correct-ans {
            color: var(--success);
            font-weight: bold;
        }
        .wrong-ans {
            color: var(--danger);
            font-weight: bold;
        }
    </style>
</head>
<body>

<div class="container" id="quiz-app">
    <div id="intro-container">
        <h1>Simulasi TKA Matematika</h1>
        <p class="subtitle">Berisi 40 soal pilihan ganda. Kerjakan dengan teliti.</p>
