        { q: "UMKM memproduksi tas. Bulan pertama 50 tas, bulan kedua 60 tas, dan selalu bertambah 10 tas. Total pesanan selama 12 bulan adalah...[cite: 2]", options: ["1.100 tas", "1.200 tas", "1.260 tas", "1.320 tas"], answer: 2 },
