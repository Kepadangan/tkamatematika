        { q: "Rata-rata 15 data adalah 18. Rata-rata 10 data pertama 15, dan 3 data selanjutnya 25. Jika data ke-15 = 2x data ke-14, maka nilai data ke-15 adalah...[cite: 3]", options: ["25", "30", "45", "60"], answer: 1 },
        { q: "Hanan membawa buah dalam mobil kapasitas 1 ton (1000 kg). Ada 10 kotak merah @25 kg. Sisa muatan untuk kotak biru @50 kg adalah sebanyak...[cite: 3]", options: ["10 kotak", "15 kotak", "20 kotak", "25 kotak"], answer: 1 },
        { q: "Gaji staf pada bulan ke-5 adalah Rp850.000 dan bulan ke-8 Rp1.150.000. Pertambahan gaji setiap bulannya adalah...[cite: 4]", options: ["Rp50.000", "Rp100.000", "Rp150.000", "Rp200.000"], answer: 1 },
