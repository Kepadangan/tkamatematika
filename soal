        { q: "Printer laser mencetak 30 halaman per menit. Waktu untuk mencetak 150 halaman adalah...[cite: 2]", options: ["3 menit", "4 menit", "5 menit", "6 menit"], answer: 2 },
        { q: "Cakram putar dengan angka 1 sampai 10 diputar. Peluang menunjuk faktor prima dari 10 (2 dan 5) adalah...[cite: 2]", options: ["1/5", "3/10", "2/5", "1/2"], answer: 0 },
        { q: "Volume air di wadah balok adalah 3.724 cm³. Jika panjang wadah 14 cm dan lebarnya 14 cm (asumsi alas persegi), ketinggian air adalah...[cite: 2]", options: ["12 cm", "19 cm", "21 cm", "25 cm"], answer: 1 },
        { q: "Dalam tes 40 soal, Benar = 4, Salah = -1, Kosong = 0. Rita menjawab 35 soal, di mana 30 soal benar. Skor Rita adalah...[cite: 3]", options: ["115", "120", "130", "140"], answer: 0 },
        { q: "Toko memiliki 42 botol sirup jeruk dan 63 botol sirup stroberi. Botol akan ditata merata ke dalam rak. Maksimal rak yang diperlukan adalah...[cite: 3]", options: ["7 rak", "9 rak", "14 rak", "21 rak"], answer: 3 },
        { q: "Dini membuat cupcake dengan resep 0,75 kg tepung untuk 6 porsi. Jika ia punya 3,75 kg tepung, porsi cupcake yang dibuat adalah...[cite: 3]", options: ["24 porsi", "27 porsi", "30 porsi", "48 porsi"], answer: 2 },
        { q: "Pak Deni mengecat dinding 4,6 m × 2,8 m. Jika 1 kaleng cat menutupi 6 m², minimal kaleng yang harus dibeli adalah...[cite: 3]", options: ["1 kaleng", "2 kaleng", "3 kaleng", "4 kaleng"], answer: 2 },
        { q: "Proyek diselesaikan 12 pekerja dalam 20 hari. Jika ingin selesai 15 hari, banyak pekerja tambahan adalah...[cite: 3]", options: ["3 orang", "4 orang", "9 orang", "16 orang"], answer: 1 },
        { q: "Diketahui f(x) = px + q. Jika f(-3) = -12 dan f(5) = 4, maka rumus fungsinya adalah...[cite: 3]", options: ["f(x) = 2x - 6", "f(x) = 2x + 6", "f(x) = 3x - 3", "f(x) = -2x - 6"], answer: 0 },
        { q: "Paman berjalan dari A ke B (200m), lalu B ke C (240m), dan C ke D (120m). Jika lintasan lurus dan siku-siku, jarak terdekat A ke D (menggunakan Pythagoras beruntun) biasanya setara dengan...[cite: 3]", options: ["240 meter", "320 meter", "400 meter", "560 meter"], answer: 2 },
