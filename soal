        <div id="questions-wrapper"></div>
        
        <div class="navigation">
            <button class="nav-btn" id="prev-btn" onclick="changeQuestion(-1)">Sebelumnya</button>
            <button class="nav-btn" id="next-btn" onclick="changeQuestion(1)">Selanjutnya</button>
            <button class="nav-btn" id="submit-btn" style="display: none; background-color: var(--success);" onclick="showResult()">Selesai & Lihat Hasil</button>
        </div>
    </div>

    <div id="result-container">
        <h2>Hasil Latihan Anda</h2>
        <div class="score-circle" id="final-score">0</div>
        <p id="result-summary"></p>
        <button class="nav-btn" onclick="location.reload()">Ulangi Latihan</button>
        
        <div class="review-list" id="review-list">
            <h3>Review Jawaban:</h3>
        </div>
    </div>
</div>

<script>
    // Data Soal 1 - 40
    const questionsData = [
